{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-preview",
  "main": "src/worker.js",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [{ "pattern": "github-preview.shakker.dev", "custom_domain": true }],
}
